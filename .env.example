# Port the API and websocket server listen on.
PORT=8080

# Postgres connection string. For Supabase use the session pooler URI from
# Project settings -> Database -> Connection string.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Secret used to sign access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API.
# Leave empty to allow any origin (local development only).
CLIENT_ORIGIN=http://localhost:5173

# Optional tuning.
NODE_ENV=development
PG_POOL_MAX=10
BCRYPT_ROUNDS=12
PRESENCE_WINDOW_SECONDS=120
MESSAGE_PAGE_SIZE=100
# Set to false to run sql/ migrations manually with `npm run migrate`.
AUTO_MIGRATE=true
